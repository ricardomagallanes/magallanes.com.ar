{
    "name": "paginaprueba",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build:model": "esbuild js/model3d.src.js --bundle --format=esm --minify --outfile=js/model3d.js",
        "build": "npm run build:model && tsc && vite build && node -e \"const fs=require('fs'); fs.mkdirSync('dist/assets/modelos', {recursive:true}); fs.copyFileSync('assets/modelos/TM-2600-R.glb', 'dist/assets/modelos/TM-2600-R.glb');\"",
        "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview"
    },
    "dependencies": {
        "antigravity": "^0.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.34.2",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.7",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    }
}
